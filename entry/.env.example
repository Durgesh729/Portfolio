# Target URL for the Vite portfolio child iframe.
# Default fallbacks in application code (entry/app/page.tsx):
# - Development: http://localhost:8080
# - Production:  https://portfolio729.vercel.app
#
# Local development default:
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:8080

# Production override (configured in Vercel Project Settings for durgesh729):
# NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio729.vercel.app
# WARNING: Do NOT point NEXT_PUBLIC_PORTFOLIO_URL to https://durgesh729.vercel.app to avoid recursive iframe loops.
